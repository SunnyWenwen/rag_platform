{
  "openapi": "3.1.0",
  "info": {
    "title": "User Remote API",
    "version": "1.0.0",
    "description": "Common envelope. Validate input and output against the System-specific schemas generated by Builder."
  },
  "servers": [{"url": "https://remote.example", "description": "Example only. Runtime sends POST to the exact Endpoint configured in the System."}],
  "paths": {
    "/": {
      "post": {
        "operationId": "executeSegment",
        "security": [{}, {"bearerAuth": []}],
        "parameters": [
          {"name": "X-Request-Id", "in": "header", "required": true, "schema": {"$ref": "../../schemas/remote_api.schema.json#/$defs/request_id"}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../schemas/remote_api.schema.json#/$defs/request"}}}
        },
        "responses": {
          "2XX": {
            "description": "Successful execution with the output envelope.",
            "content": {"application/json": {"schema": {"$ref": "../../schemas/remote_api.schema.json#/$defs/success"}}}
          },
          "4XX": {"$ref": "#/components/responses/Failure"},
          "5XX": {"$ref": "#/components/responses/Failure"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "responses": {
      "Failure": {
        "description": "Remote application error.",
        "content": {"application/json": {"schema": {"$ref": "../../schemas/remote_api.schema.json#/$defs/failure"}}}
      }
    }
  }
}
