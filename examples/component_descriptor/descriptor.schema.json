{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/retrieval/component-descriptor/0.1-draft",
  "title": "Component Descriptor — discussion draft, not a released protocol",
  "description": "B normalized descriptor. Validates document structure only; embedded schema policy, paths, registry, refinement semantics and capability checks require the Engine. Examples are fixtures.",
  "type": "object",
  "properties": {
    "descriptor_version": {
      "const": "component-descriptor/0.1-draft"
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "implementation_version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "config_schema": {
      "$ref": "#/$defs/SchemaObject"
    },
    "io": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/Boundary"
        },
        "output": {
          "$ref": "#/$defs/Boundary"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "data_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataRule"
      },
      "minItems": 0
    },
    "option_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OptionSource"
      },
      "minItems": 0
    },
    "ui_hints": {
      "$ref": "#/$defs/UiHints"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "minItems": 0
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 0
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Resource"
      },
      "minItems": 0
    },
    "required_ui_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "engine_api": {
          "type": "string",
          "minLength": 1
        },
        "sdk_api": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "execution_capabilities": {
      "type": "object",
      "properties": {
        "async": {
          "type": "boolean"
        },
        "batch": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "change_impact": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChangeImpact"
      },
      "minItems": 0
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "descriptor_version",
    "component_id",
    "implementation_version",
    "title",
    "description",
    "scope",
    "config_schema",
    "io"
  ],
  "additionalProperties": false,
  "$defs": {
    "Path": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "SchemaObject": {
      "allOf": [
        {
          "$ref": "https://json-schema.org/draft/2020-12/schema"
        },
        {
          "type": "object"
        }
      ]
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {}
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "config",
                "item",
                "context"
              ]
            },
            "path": {
              "$ref": "#/$defs/Path"
            }
          },
          "required": [
            "scope",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte",
                "in",
                "contains"
              ]
            },
            "left": {
              "$ref": "#/$defs/Value"
            },
            "right": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "exists"
            },
            "left": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "op",
            "left"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "minItems": 1
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "minItems": 1
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Predicate"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Boundary": {
      "type": "object",
      "properties": {
        "contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "enum": [
            "direct",
            "list"
          ]
        },
        "constraints": {
          "$ref": "#/$defs/SchemaObject"
        },
        "inherit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Path"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "contract_ref",
        "shape"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "pipeline": {
          "enum": [
            "ingestion",
            "inference"
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "enum": [
              "import",
              "parsing",
              "chunking",
              "embedding",
              "indexing",
              "query_transformation",
              "retrieval",
              "rerank"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "pipeline",
        "modules"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/Path"
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "path",
        "value"
      ],
      "additionalProperties": false
    },
    "FieldSource": {
      "type": "object",
      "properties": {
        "side": {
          "enum": [
            "input",
            "output"
          ]
        },
        "container": {
          "$ref": "#/$defs/Path"
        },
        "name": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "side",
        "container",
        "name"
      ],
      "additionalProperties": false
    },
    "Declare": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "input",
            "output"
          ]
        },
        "target": {
          "$ref": "#/$defs/Path"
        },
        "name": {
          "$ref": "#/$defs/Value"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "for_each": {
          "$ref": "#/$defs/Path"
        },
        "when": {
          "$ref": "#/$defs/Predicate"
        },
        "action": {
          "const": "declare"
        },
        "schema": {
          "$ref": "#/$defs/SchemaObject"
        },
        "schema_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "side",
        "target",
        "name",
        "action",
        "schema"
      ],
      "additionalProperties": false
    },
    "Copy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "input",
            "output"
          ]
        },
        "target": {
          "$ref": "#/$defs/Path"
        },
        "name": {
          "$ref": "#/$defs/Value"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "for_each": {
          "$ref": "#/$defs/Path"
        },
        "when": {
          "$ref": "#/$defs/Predicate"
        },
        "action": {
          "const": "copy"
        },
        "source": {
          "$ref": "#/$defs/FieldSource"
        }
      },
      "required": [
        "id",
        "side",
        "target",
        "name",
        "action",
        "source"
      ],
      "additionalProperties": false
    },
    "DataRule": {
      "oneOf": [
        {
          "$ref": "#/$defs/Declare"
        },
        {
          "$ref": "#/$defs/Copy"
        }
      ]
    },
    "OptionSource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/Path"
        },
        "kind": {
          "enum": [
            "fields",
            "vectors",
            "llm_profiles",
            "tokenizer_profiles",
            "service_profiles",
            "index_fields"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "side": {
              "enum": [
                "input",
                "output",
                "context"
              ]
            },
            "path": {
              "$ref": "#/$defs/Path"
            }
          },
          "required": [
            "side",
            "path"
          ],
          "additionalProperties": false
        },
        "filter": {
          "type": "object",
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "array",
                  "object",
                  "null"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "required": {
              "type": "boolean"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "target",
        "kind",
        "source"
      ],
      "additionalProperties": false
    },
    "Rule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/Path"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "constraint"
            },
            "assert": {
              "$ref": "#/$defs/Predicate"
            },
            "for_each": {
              "$ref": "#/$defs/Path"
            }
          },
          "required": [
            "id",
            "target",
            "code",
            "message",
            "kind",
            "assert"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/Path"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "unique_by"
            },
            "item_path": {
              "$ref": "#/$defs/Path"
            }
          },
          "required": [
            "id",
            "target",
            "code",
            "message",
            "kind",
            "item_path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/Path"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "applicability"
            },
            "when": {
              "$ref": "#/$defs/Predicate"
            },
            "presentation": {
              "enum": [
                "hide",
                "disable"
              ]
            }
          },
          "required": [
            "id",
            "target",
            "code",
            "message",
            "kind",
            "when",
            "presentation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "UiField": {
      "type": "object",
      "properties": {
        "widget": {
          "enum": [
            "text",
            "textarea",
            "number",
            "checkbox",
            "select",
            "multi_select",
            "object",
            "array",
            "field_picker",
            "service_picker"
          ]
        },
        "option_source": {
          "type": "string",
          "minLength": 1
        },
        "item_layout": {
          "enum": [
            "stack",
            "inline"
          ]
        },
        "separator": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "UiHints": {
      "type": "object",
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Path"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Path"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "advanced": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "id",
              "title",
              "fields"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/UiField"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Capability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/Predicate"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "Resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "llm",
            "embedding_api",
            "rerank_api",
            "tokenizer",
            "elasticsearch",
            "mongodb",
            "storage",
            "remote_service"
          ]
        },
        "service_parameter": {
          "$ref": "#/$defs/Path"
        },
        "profile_parameter": {
          "$ref": "#/$defs/Path"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "when": {
          "$ref": "#/$defs/Predicate"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "ChangeImpact": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Path"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "effects": {
          "type": "array",
          "items": {
            "enum": [
              "reparse",
              "rechunk",
              "reembed",
              "reindex",
              "inference_retest",
              "runtime_reprepare"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "parameters",
        "effects"
      ],
      "additionalProperties": false
    }
  }
}
