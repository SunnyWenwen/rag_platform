    {
      "descriptor_version": "0.2-draft",
      "module": "retrieval",
      "component_id": "builtin",
      "component_version": "1.0.0",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "vector_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "title": "向量欄位"
          },
          "fulltext_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "title": "全文欄位"
          },
          "per_route_k": {
            "type": "integer",
            "minimum": 1,
            "title": "每路 Top K"
          },
          "fusion": {
            "type": "string",
            "enum": [
              "RRF",
              "Sum Score"
            ],
            "title": "同 Query 多路融合"
          },
          "group_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "title": "Group by 合併欄位"
          },
          "top_n": {
            "type": "integer",
            "minimum": 1,
            "title": "Top N"
          },
          "rrf_k": {
            "type": "integer",
            "minimum": 1,
            "title": "RRF k"
          }
        },
        "required": [
          "per_route_k"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "vector_fields"
            ]
          },
          {
            "required": [
              "fulltext_fields"
            ]
          }
        ]
      },
      "io": {
        "input": "QueryContext[]",
        "output": "QueryContext[]"
      },
      "option_sources": {
        "/vector_fields/*": {
          "source": "index_plan.vectors"
        },
        "/fulltext_fields/*": {
          "source": "index_plan.fulltext"
        },
        "/group_by/*": {
          "source": "candidate.document_fields",
          "types": [
            "string"
          ]
        }
      },
      "data_rules": [],
      "constraints": [],
      "ui_hints": {
        "previews": {
          "effective_io": {
            "collapsed": true
          }
        },
        "order": [
          "/vector_fields",
          "/fulltext_fields",
          "/per_route_k",
          "/fusion",
          "/group_by",
          "/top_n"
        ],
        "advanced": [
          "/rrf_k"
        ],
        "visible_when": {
          "/fusion": {
            "all": [
              {
                "paths": [
                  "/vector_fields",
                  "/fulltext_fields"
                ],
                "minimum_selected": 2
              }
            ]
          },
          "/rrf_k": {
            "all": [
              {
                "paths": [
                  "/vector_fields",
                  "/fulltext_fields"
                ],
                "minimum_selected": 2
              },
              {
                "path": "/fusion",
                "equals": "RRF"
              }
            ]
          }
        }
      }
    },
