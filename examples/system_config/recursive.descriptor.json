{
  "descriptor_version": "0.2-draft",
  "module": "chunking",
  "component_id": "recursive",
  "component_version": "1.0.0",
  "parameters_schema": {
    "type": "object",
    "properties": {
      "split_field": {
        "type": "string",
        "minLength": 1
      },
      "output_field": {
        "type": "string",
        "minLength": 1
      },
      "copy_fields": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source_field": {
              "type": "string",
              "minLength": 1
            },
            "output_field": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source_field",
            "output_field"
          ],
          "additionalProperties": false
        }
      },
      "max_tokens": {
        "type": "integer",
        "minimum": 1
      },
      "overlap_tokens": {
        "type": "integer",
        "minimum": 0
      },
      "tokenizer_profile_id": {
        "type": "string",
        "minLength": 1
      },
      "separators": {
        "type": "array",
        "title": "分隔符順序",
        "items": {
          "type": "string",
          "title": "分隔符"
        }
      },
      "keep_separator": {
        "type": "boolean",
        "title": "保留分隔符"
      },
      "preserve_original": {
        "type": "boolean",
        "title": "複製完整原文"
      },
      "include_original_chunk": {
        "type": "boolean",
        "title": "額外保留原文 Chunk"
      }
    },
    "required": [
      "split_field",
      "output_field",
      "copy_fields",
      "max_tokens",
      "overlap_tokens",
      "tokenizer_profile_id"
    ],
    "additionalProperties": false
  },
  "io": {
    "input": "Document[]",
    "output": "Document[]"
  },
  "option_sources": {
    "/split_field": {
      "source": "input.structdata",
      "types": [
        "string"
      ],
      "required": true
    },
    "/tokenizer_profile_id": {
      "source": "tokenizer_profiles"
    },
    "/copy_fields/*/source_field": {
      "source": "input.structdata",
      "types": [
        "string",
        "string_array",
        "integer",
        "number",
        "boolean",
        "date",
        "datetime"
      ]
    }
  },
  "data_rules": [
    {
      "op": "declare",
      "target": "/output_field",
      "schema": {
        "type": "string",
        "required": true
      }
    },
    {
      "op": "copy",
      "source": "/source_field",
      "target": "/output_field",
      "for_each": "/copy_fields"
    }
  ],
  "constraints": [
    {
      "op": "lt",
      "left": "/overlap_tokens",
      "right": "/max_tokens"
    }
  ],
  "ui_hints": {
    "advanced": [
      "/copy_fields",
      "/overlap_tokens",
      "/separators",
      "/keep_separator",
      "/preserve_original",
      "/include_original_chunk"
    ]
  }
}
