  {
    "descriptor_version": "0.2-draft",
    "module": "embedding",
    "component_id": "dense",
    "component_version": "1.0.0",
    "parameters_schema": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "向量空間的識別。Profile 定義模型與版本、向量維度及文件／查詢的編碼設定。Retrieval 需使用相容的 Query Encoder。"
        },
        "service_source": {
          "type": "string",
          "enum": [
            "DEV test use",
            "Embedding API"
          ],
          "default": "DEV test use",
          "title": "服務來源"
        },
        "embedding_service_ref": {
          "type": "string",
          "minLength": 1,
          "title": "Embedding 服務引用"
        },
        "embedding_model": {
          "type": "string",
          "minLength": 1,
          "title": "模型"
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "title": "向量維度"
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_field": {
                "type": "string",
                "minLength": 1,
                "title": "來源欄位"
              },
              "vector_name": {
                "type": "string",
                "minLength": 1,
                "title": "向量欄位"
              }
            },
            "required": [
              "source_field",
              "vector_name"
            ],
            "additionalProperties": false
          },
          "title": "向量映射",
          "minItems": 1,
          "default": [
            {
              "source_field": "text",
              "vector_name": "text"
            }
          ]
        },
        "compose_text": {
          "type": "boolean",
          "default": false,
          "title": "啟用組合文字"
        },
        "composition_field": {
          "type": "string",
          "minLength": 1,
          "default": "embedding_text",
          "title": "組合輸出欄位"
        },
        "composition_template": {
          "type": "string",
          "minLength": 1,
          "title": "文字模板",
          "default": "標題：{{structdata.title}}\n內容：{{structdata.text}}"
        }
      },
      "required": [
        "mappings",
        "profile"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "compose_text"
            ],
            "properties": {
              "compose_text": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "composition_field",
              "composition_template"
            ]
          }
        }
      ]
    },
    "io": {
      "input": "Document[]",
      "output": "Document[]"
    },
    "option_sources": {
      "/profile": {
        "source": "profiles"
      },
      "/mappings/*/source_field": {
        "source": "input.structdata",
        "types": [
          "string"
        ],
        "required": true
      }
    },
    "data_rules": [
      {
        "op": "compose",
        "enabled": "/compose_text",
        "target": "/composition_field",
        "template": "/composition_template"
      },
      {
        "op": "vector",
        "for_each": "/mappings",
        "source": "/source_field",
        "target": "/vector_name",
        "profile": "/profile"
      }
    ],
    "constraints": [],
    "ui_hints": {
      "previews": {
        "effective_io": {
          "collapsed": true
        }
      },
      "order": [
        "/mappings"
      ],
      "groups": [
        {
          "title": "組合文字欄位",
          "fields": [
            "/compose_text",
            "/composition_field",
            "/composition_template"
          ],
          "example": {
            "原始 structdata": {
              "title": "維護指南",
              "text": "定期清潔濾網"
            },
            "文字模板": "標題：{{structdata.title}}\n內容：{{structdata.text}}",
            "產生的 structdata.embedding_text": "標題：維護指南\n內容：定期清潔濾網",
            "向量映射": {
              "source_field": "embedding_text",
              "vector_name": "combined"
            }
          }
        },
        {
          "title": "Embedding 模型設定",
          "fields": [
            "/service_source",
            "/profile",
            "/embedding_service_ref",
            "/embedding_model",
            "/dimensions"
          ]
        }
      ]
    }
  },
