{
  "system_id": "local-search-example",
  "config_revision": "revision-1",
  "config": {
    "contract_version": "0.1-draft",
    "pipelines": {
      "ingestion": {
        "import": {
          "kind": "builtin",
          "method_id": "platform",
          "method_version": "1.0.0",
          "parameters": {
            "structdata": {
              "body": {
                "type": "string",
                "required": true
              },
              "title": {
                "type": "string",
                "required": true
              }
            }
          }
        },
        "parsing": {
          "kind": "builtin",
          "method_id": "passthrough",
          "method_version": "1.0.0",
          "parameters": {}
        },
        "chunking": {
          "kind": "builtin",
          "method_id": "recursive",
          "method_version": "1.0.0",
          "parameters": {
            "split_field": "body",
            "output_field": "text",
            "copy_fields": [
              {
                "source_field": "title",
                "output_field": "title"
              }
            ],
            "max_tokens": 500,
            "overlap_tokens": 50,
            "tokenizer_profile_id": "fixture"
          }
        },
        "embedding": {
          "kind": "builtin",
          "method_id": "dense",
          "method_version": "1.0.0",
          "parameters": {
            "source_field": "text",
            "vector_name": "text",
            "profile": "text-v1"
          }
        },
        "indexing": {
          "kind": "builtin",
          "method_id": "local",
          "method_version": "1.0.0",
          "parameters": {
            "persistence": "memory",
            "fulltext_field": "text",
            "vector_name": "text"
          }
        }
      },
      "inference": {
        "inference_input": {
          "kind": "builtin",
          "method_id": "platform",
          "method_version": "1.0.0",
          "parameters": {}
        },
        "query_transformation": {
          "kind": "builtin",
          "method_id": "none",
          "method_version": "1.0.0",
          "parameters": {}
        },
        "retrieval": {
          "kind": "builtin",
          "method_id": "builtin",
          "method_version": "1.0.0",
          "parameters": {
            "vector_name": "text",
            "query_profile": "text-v1",
            "top_k": 10
          }
        },
        "rerank": {
          "kind": "builtin",
          "method_id": "none",
          "method_version": "1.0.0",
          "parameters": {}
        }
      }
    }
  }
}
