{
  "system_id": "local-search-example",
  "config_revision": "revision-2",
  "config": {
    "contract_version": "0.2-draft",
    "pipelines": {
      "ingestion": {
        "import": {
          "component_id": "platform",
          "component_version": "1.0.0",
          "parameters": {
            "structdata": {
              "body": {
                "type": "string",
                "required": true
              },
              "title": {
                "type": "string",
                "required": true,
                "filterable": true
              },
              "price": {
                "type": "number",
                "required": false,
                "searchable": false,
                "filterable": false
              },
              "tags": {
                "type": "string_array",
                "required": false,
                "searchable": false,
                "filterable": true
              }
            },
            "request_parameters": [
              {
                "name": "language",
                "type": "string",
                "required": false
              }
            ]
          }
        },
        "parsing": {
          "component_id": "remote_api",
          "component_version": "1.0.0",
          "through": "parsing",
          "service_ref": "document-normalizer",
          "parameters": {
            "language": "{{language}}"
          },
          "output": {
            "structdata": {
              "body": {
                "type": "string",
                "required": true
              },
              "title": {
                "type": "string",
                "required": true,
                "filterable": true
              },
              "price": {
                "type": "number",
                "required": false,
                "searchable": false,
                "filterable": false
              },
              "tags": {
                "type": "string_array",
                "required": false,
                "searchable": false,
                "filterable": true
              }
            }
          },
          "auth": {
            "bearer_token": "{{PARSER_API_TOKEN}}"
          }
        },
        "chunking": {
          "component_id": "recursive",
          "component_version": "1.0.0",
          "parameters": {
            "split_field": "body",
            "output_field": "text",
            "copy_fields": [
              {
                "source_field": "title",
                "output_field": "title"
              },
              {
                "source_field": "price",
                "output_field": "price"
              },
              {
                "source_field": "tags",
                "output_field": "tags"
              }
            ],
            "max_tokens": "{{CHUNK_MAX_TOKENS}}",
            "overlap_tokens": 50,
            "tokenizer_profile_id": "fixture"
          }
        },
        "embedding": {
          "component_id": "dense",
          "component_version": "1.0.0",
          "parameters": {
            "mappings": [
              {
                "source_field": "text",
                "vector_name": "text"
              }
            ],
            "profile": "text-v1"
          }
        },
        "indexing": {
          "component_id": "local",
          "component_version": "1.0.0",
          "parameters": {
            "persistence": "memory",
            "vector_name": "text",
            "structdata_overrides": {
              "text": {
                "searchable": true
              },
              "price": {
                "filterable": true
              }
            }
          }
        }
      },
      "inference": {
        "inference_input": {
          "component_id": "platform",
          "component_version": "1.0.0",
          "parameters": {}
        },
        "query_transformation": {
          "component_id": "none",
          "component_version": "1.0.0",
          "parameters": {}
        },
        "retrieval": {
          "component_id": "builtin",
          "component_version": "1.0.0",
          "parameters": {
            "vector_fields": [
              "text"
            ],
            "per_route_k": 10
          }
        },
        "rerank": {
          "component_id": "none",
          "component_version": "1.0.0",
          "parameters": {}
        },
        "fixed_filters": [
          {
            "field": "structdata.price",
            "operator": "gte",
            "value": 300
          }
        ]
      }
    },
    "secret": {
      "PARSER_API_TOKEN": null,
      "CHUNK_MAX_TOKENS": null,
      "language": null
    }
  }
}
