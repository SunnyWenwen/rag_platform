flowchart TB
  %% 同名 SVG 固定版面，PNG 由 SVG 轉出。
  subgraph B["B · Retrieval Engine Framework"]
    direction LR
    B1["B-1 · Schema／Component Descriptor"]
    B2["B-2 · 共用 Engine Library"] --> B3["B-3 · Runtime Image<br/>Runtime API ＋ Library"]
  end
  subgraph A["A · Builder DEV"]
    direction TB
    A1["A-1 · Builder UI"] --> A2["A-2 · Builder Backend<br/>管理 API、業務路由與同步"]
    A2 --> A3["A-3 · Config Revision 與部署意圖"]
    A2 -->|"initialize／update／recover_index · ingestion"| Ing["A-4 · Ingestion Runtime"]
    A2 -->|"reload · inference"| Inf["A-4 · Inference Runtime"]
    %% detach 卸載單一流程並保留 ES 索引。System DELETE 清除受管索引。
    Ing -->|"寫入與占用"| ES["Elasticsearch<br/>檢索資料索引 ＋ 共用控制索引"]
    Inf -->|"查詢同一索引"| ES
    A3 -. "同版 Config 與同一索引綁定" .-> Ing
    A3 -. "同版 Config 與同一索引綁定" .-> Inf
  end
  subgraph C["C · FTEST／ENT"]
    direction TB
    C1["C-1 · 同版 Config ＋部署設定 ＋ Image 版本"]
    C1 --> C2["C-2 · 使用單位部署"]
    C2 -->|"以 pipeline 選擇啟動流程"| C3["C-3 · 同一 Runtime Image<br/>Ingestion 與 Inference 可分 Pod"]
    C3 --> C5["目標環境 ES、模型、Remote API 與 Secret"]
  end
  B1 -.-> A2
  B2 -.-> Ing
  B2 -.-> Inf
  B3 -.-> C3
  A3 -->|"Export"| C1

  classDef builder fill:#eef2ff,stroke:#a0aee4,color:#1b2d57
  classDef runtime fill:#edf8f4,stroke:#8fbcac,color:#173e36
  classDef deploy fill:#fff4e4,stroke:#d5a665,color:#5a3c16
  class B1,B2,B3,A1,A2,A3 builder
  class Ing,Inf,ES runtime
  class C1,C2,C3,C5 deploy
