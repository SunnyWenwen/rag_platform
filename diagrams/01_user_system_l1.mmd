flowchart TB
    subgraph User["User"]
        direction LR
        B["1. Build（設定 Config）"] --> I["2. Ingestion"]
        I --> Q["3. Inference"]
        Q --> E["4. Evaluation"]
        E --> X["5. Export YAML"]
        E --> C["修改 Config"]
        C -->|如果有調整ingestion的設定, 需重新Ingestion| I
        C -->|只調整inference設定, 不需重新ingestion| Q
    end

    S["RAG System"]
    R["評估報告"]
    Y["YAML 設定檔"]

    B -. 建立 .-> S
    I -. "建立 Chunks / Indexes" .-> S
    Q -. 查詢 .-> S
    E -. 評估 .-> S
    C -. 更新設置 .-> S

    E -. 產出 .-> R
    X -. 產出 .-> Y

    classDef user fill:#e9f2ff,stroke:#6086c8,color:#143054
    classDef system fill:#ecf8f2,stroke:#599d85,color:#153f32
    class B,I,Q,E,X,C user
    class S,R,Y system
