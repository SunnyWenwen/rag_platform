flowchart TB
  %% 同名 SVG 固定版面，PNG 由 SVG 轉出。
  subgraph ING["Ingestion · 文件處理與索引"]
    direction LR
    Import["Import<br/>整批預檢，逐份派工"]
    Parse["Parsing<br/>結構化直傳、檔案解析"]
    Chunk["Chunking<br/>Fixed-size、Recursive、Header-aware"]
    Embed["Embedding<br/>向量欄位、Profile、維度"]
    ES["Indexing<br/>Elasticsearch"]
    Import -->|"Document"| Parse -->|"Document[]"| Chunk --> Embed --> ES
  end
  subgraph INF["Inference · QueryContext[]"]
    direction LR
    Input["Inference Input<br/>查詢參數與 Filter"]
    Rewrite["Query Transformation<br/>None 或 Rewrite（單／多 Query）"]
    Search["Retrieval<br/>ES 全文、向量或混合"]
    Rerank["Rerank<br/>None 或評分服務"]
    Result["ResultSet<br/>候選 Document 與分數"]
    Input --> Rewrite --> Search --> Rerank --> Result
  end
  ES -. "共同 IndexBinding" .-> Search
  subgraph CONFIG["同一 Engine Library 組裝不同 System"]
    direction LR
    A["A · 內建元件<br/>結構化直傳 → ES"]
    B["B · 套用全域模板<br/>多 Query Rewrite → ES"]
    C["C · 自備 Remote API<br/>Remote Parsing → ES"]
  end
  subgraph REMOTE["Remote API 可替換範圍"]
    direction LR
    RemoteIn["Parsing／Chunking／Embedding<br/>單節點或連續區段"]
    RemoteOut["Query Transformation／Retrieval／Rerank<br/>單節點或連續區段"]
  end
  A -.-> ING
  B -.-> INF
  C -.-> RemoteIn
  RemoteIn -.-> Parse
  RemoteOut -.-> Search

  classDef ing fill:#eef2ff,stroke:#a0aee4,color:#1b2d57
  classDef inf fill:#edf8f4,stroke:#8fbcac,color:#173e36
  classDef remote fill:#fff4e4,stroke:#d5a665,color:#5a3c16
  class Import,Parse,Chunk,Embed,ES ing
  class Input,Rewrite,Search,Rerank,Result inf
  class A,B,C,RemoteIn,RemoteOut remote
