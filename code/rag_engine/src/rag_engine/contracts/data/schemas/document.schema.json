{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-builder.example/schemas/document.schema.json",
  "title": "Document",
  "type": "object",
  "properties": {
    "document_id": {"$ref": "#/$defs/document_id"},
    "source_revision": {
      "type": ["string", "null"]
    },
    "data_id": {
      "description": "Chunk identity within a retrieval scope. Its mapping to a chunk may change after rechunking.",
      "type": "string",
      "minLength": 1
    },
    "structdata": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "base64": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "media_type"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "uri"
          ]
        },
        {
          "required": [
            "base64"
          ]
        }
      ]
    },
    "metadata": {
      "type": "object"
    },
    "vectors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/denseVector"
      }
    }
  },
  "required": [
    "document_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "document_id": {
      "description": "Stable System-scoped source ID. The document-id format requires a UTF-8 byte length no greater than maxLength.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+(?![\\s\\S])",
      "format": "document-id"
    },
    "denseVector": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "embedding_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "source_field": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "values",
        "embedding_profile_id",
        "source_field"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "required": [
            "document_id",
            "data_id",
            "structdata"
          ]
        }
      ]
    }
  }
}
