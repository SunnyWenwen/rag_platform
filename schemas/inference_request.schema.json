{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-builder.example/schemas/inference_request.schema.json",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "https://rag-builder.example/schemas/query_context.schema.json#/$defs/filter"
      }
