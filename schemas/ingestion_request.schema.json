{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-builder.example/schemas/ingestion_request.schema.json",
  "type": "object",
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "https://rag-builder.example/schemas/document.schema.json"
          },
          {
            "anyOf": [
              {
                "required": [
                  "structdata"
                ]
              },
              {
                "required": [
                  "content"
                ]
              }
            ],
            "properties": {
              "vectors": {
                "maxProperties": 0
              }
            }
          }
        ]
      }
    },
    "parameters": {
      "type": "object"
    }
  },
  "required": [
    "documents"
  ],
  "additionalProperties": false
}
