{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-builder.example/schemas/data.schema.json",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "data_id": {
      "type": "string",
      "minLength": 1
    },
    "structdata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "base64": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "media_type"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "uri"
          ]
        },
        {
          "required": [
            "base64"
          ]
        }
      ]
    },
    "metadata": {
      "type": "object"
    },
    "vectors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/denseVector"
      }
    }
  },
  "required": [
    "document_id"
  ],
  "additionalProperties": false,
  "$defs": {
    "denseVector": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "embedding_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "source_field": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "values",
        "embedding_profile_id",
        "source_field"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "required": [
            "document_id",
            "source_revision",
            "data_id",
            "structdata"
          ]
        }
      ]
    }
  }
}
