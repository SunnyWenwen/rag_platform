{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-builder:parsed-document:0.2-draft",
  "title": "ParsedDocument 0.2 draft — flat units",
  "description": "Parser output / Chunker input. Ordered independent units; no structure tree or mandatory unit_id.",
  "type": "object",
  "required": [
    "document_id",
    "source_revision",
    "units",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Unit"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    }
  },
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Unit": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    }
  }
}
