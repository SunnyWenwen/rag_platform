{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-builder:chunk:0.1-draft",
  "title": "Chunk 0.1 draft",
  "description": "六個固定頂層 key；Chunking、Embedding 與 Inference 共用資料草案。形狀之外仍須驗證來源、ID、向量 Binding 與可信 metadata。",
  "type": "object",
  "properties": {
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "_rag": {
          "$ref": "#/$defs/RagMetadata"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "vectors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/DenseVector"
      }
    }
  },
  "required": [
    "chunk_id",
    "document_id",
    "source_revision",
    "fields",
    "metadata",
    "vectors"
  ],
  "additionalProperties": false,
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "output_field": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "split",
            "copy"
          ]
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "block_start": {
          "type": "integer",
          "minimum": 0
        },
        "block_end": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_start": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_end": {
          "type": "integer",
          "minimum": 0
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "urn:rag-builder:parsed-document:0.1-draft#/$defs/Location"
          }
        }
      },
      "required": [
        "field",
        "output_field",
        "role"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "start": [
          "end"
        ],
        "end": [
          "start"
        ],
        "block_start": [
          "block_end",
          "block_id",
          "schema_id"
        ],
        "block_end": [
          "block_start",
          "block_id",
          "schema_id"
        ],
        "chunk_start": [
          "chunk_end"
        ],
        "chunk_end": [
          "chunk_start"
        ],
        "block_id": [
          "schema_id"
        ]
      },
      "allOf": [
        {
          "not": {
            "required": [
              "start",
              "block_start"
            ]
          }
        }
      ]
    },
    "RagMetadata": {
      "type": "object",
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "chunking": {
          "type": "object",
          "properties": {
            "chunking_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "chunk_ordinal": {
              "type": "integer",
              "minimum": 0
            },
            "task_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "chunking_fingerprint",
            "chunk_ordinal",
            "task_id"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "DenseVector": {
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "embedding_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "source_field": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "values",
        "embedding_profile_id",
        "source_field"
      ],
      "additionalProperties": false
    }
  }
}
