{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-builder.example/schemas/query_context.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "ori_query": {
        "type": "string",
        "minLength": 1
      },
      "query": {
        "type": "string",
        "minLength": 1
      },
      "filters": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "eq",
                "in"
              ]
            },
            "value": {}
          },
          "required": [
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "result_sets": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "https://rag-builder.example/schemas/data.schema.json#/$defs/candidate"
                  },
                  "score": {
                    "type": "number"
                  }
                },
                "required": [
                  "data"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "key",
            "items"
          ],
          "additionalProperties": false
        }
      },
      "metadata": {
        "type": "object"
      }
    },
    "required": [
      "ori_query",
      "query",
      "filters",
      "result_sets",
      "metadata"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "filter": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "eq",
            "in"
          ]
        },
        "value": {}
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
