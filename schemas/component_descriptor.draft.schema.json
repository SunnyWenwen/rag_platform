    "parameters_schema": {
      "type": "object"
    },
    "io": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "option_sources": {
