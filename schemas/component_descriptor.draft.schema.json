{
  "type": "object",
  "properties": {
    "descriptor_version": {
      "const": "0.1-draft"
    },
    "module": {
      "enum": [
        "import",
        "parsing",
        "chunking",
        "embedding",
        "indexing",
        "inference_input",
        "query_transformation",
        "retrieval",
        "rerank"
      ]
    },
    "method_id": {
      "type": "string",
      "minLength": 1
