                },
                "required": [
                  "type",
                  "required"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "op",
              "target",
              "schema"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "copy"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "for_each": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "source",
              "target"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "vector"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "source",
              "target",
              "profile"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "ui_hints": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "const": "lt"
