  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component Descriptor v0.1 review draft",
  "description": "Offline schema for the reviewed subset. Module I/O, pointer targets and context-dependent validity are also checked semantically."
}
