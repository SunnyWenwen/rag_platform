          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      }
    },
    "data_rules": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "declare"
              },
              "target": {
