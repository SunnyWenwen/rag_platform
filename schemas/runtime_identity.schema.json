{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-builder.example/schemas/runtime_identity.schema.json",
  "title": "Runtime system and index identity",
  "$defs": {
    "uuid_v4": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "env": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "deployment_env": {
      "type": "object",
      "properties": {"env": {"$ref": "#/$defs/env"}},
      "required": ["env"]
    },
    "standalone_deployment_env": {
      "allOf": [
        {"$ref": "#/$defs/deployment_env"},
        {"properties": {"env": {"not": {"const": "builder"}}}}
      ]
    }
  }
}
