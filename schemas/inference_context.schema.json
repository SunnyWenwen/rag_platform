{
  "$defs": {
    "Chunk": {
      "$ref": "urn:rag-builder:chunk:0.2-draft"
    },
    "FilterCondition": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "in"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "FilterCondition",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "eq"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "in"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "JsonValue": {},
    "QueryContext": {
      "additionalProperties": false,
      "properties": {
        "ori_query": {
          "minLength": 1,
          "title": "Ori Query",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/FilterCondition"
          },
          "title": "Filters",
          "type": "array"
        },
        "result_sets": {
          "items": {
            "$ref": "#/$defs/ResultSet"
          },
          "title": "Result Sets",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "ori_query",
        "query"
      ],
      "title": "QueryContext",
      "type": "object"
    },
    "ResultItem": {
      "additionalProperties": false,
      "properties": {
        "chunk": {
          "$ref": "#/$defs/Chunk"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "chunk"
      ],
      "title": "ResultItem",
      "type": "object"
    },
    "ResultSet": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ResultItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "key"
      ],
      "title": "ResultSet",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/QueryContext"
  },
  "type": "array",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-builder.example.invalid/schemas/query-context-list-0.3-draft.schema.json",
  "title": "QueryContext[] — current inference data",
  "description": "Approved simplified inference contract. Breaking replacement of the old state wrapper; no historical result sets. Semantic checks also apply."
}
